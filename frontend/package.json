{
  "name": "renbrowser-frontend",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../build/scripts/fetch-micron-wasm.mjs",
    "postinstall": "node ../build/scripts/ensure-micron-parser-package.js",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:tsgo": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "audit": "pnpm audit --audit-level=moderate",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test --config playwright.config.ts --grep-invert visual",
    "test:visual": "playwright test --config playwright.config.ts e2e/visual.spec.ts",
    "test:e2e:update": "playwright test --config playwright.config.ts e2e/visual.spec.ts --update-snapshots",
    "i18n:template": "node src/lib/i18n/sync-template.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "1.63.0",
    "@wailsio/runtime": "3.0.0",
    "bits-ui": "2.20.2",
    "dompurify": "3.4.17",
    "jszip": "^3.10.2",
    "marked": "18.1.2",
    "micron-parser": "github:RFnexus/micron-parser-js",
    "pdfjs-dist": "^6.4.299",
    "runed": "0.38.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.43.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
